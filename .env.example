# OpenRouter 文本（免费 Laguna/Ultra/Super + 付费 DeepSeek；Ling 已下架勿再用）
# https://openrouter.ai/ — Key 形如 sk-or-v1-...
# AI_BASE_URL=https://openrouter.ai/api
# AI_TEXT_PROVIDER=openrouter
# AI_TEXT_MODEL=poolside/laguna-s-2.1:free
# OPENROUTER_API_KEY_FREE=sk-or-v1-...
# OPENROUTER_API_KEY_PAID=sk-or-v1-...
# AI_API_KEY=   # 可与 FREE 相同，兼容旧逻辑
# OPENROUTER_FREE_TEXT_MODEL=poolside/laguna-s-2.1:free
# 备选：nvidia/nemotron-3-ultra-550b-a55b:free
# 备选：nvidia/nemotron-3-super-120b-a12b:free

# DeepSeek / 妙飞（默认文本：deepseek-v4-flash）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ChatFire / DeepSeek 文本（4022 或官方）
# DeepSeek 官方：https://api.deepseek.com
# 4022 代理：https://api.4022543.xyz（需代理平台自己的 key）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_TEXT_MODEL=deepseek-v4-flash

# 智谱开放平台（文本 / 生图 / 视频免费模型）
# https://docs.bigmodel.cn/cn/guide/models/free/glm-4.7-flash
# https://docs.bigmodel.cn/cn/guide/models/free/cogview-3-flash
# https://docs.bigmodel.cn/cn/guide/models/free/cogvideox-flash
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_TEXT_MODEL=glm-4.7-flash
ZHIPU_AGENT_MODEL=glm-4.7-flash
ZHIPU_IMAGE_MODEL=cogview-3-flash
ZHIPU_VIDEO_MODEL=cogvideox-flash

# Agnes Image（定妆 / 参考图）
# https://wiki.agnes-ai.com/en/docs/agnes-image-21-flash
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_PORTRAIT_MODEL=agnes-image-2.1-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# 可选：本机代理（Agnes 走 Cloudflare，国内直连常 Connect Timeout / ECONNRESET；Node 不读系统代理）
# 定妆生图务必配置，例如：
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
# AGNES_IMAGE_CONCURRENCY=1

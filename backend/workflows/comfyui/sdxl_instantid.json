{
  "_comment": "SDXL + InstantID 定妆参考锁脸（cubiq/ComfyUI_InstantID，需英文 prompt）",
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "animagine-xl-3.1.safetensors" }
  },
  "11": {
    "class_type": "InstantIDModelLoader",
    "inputs": { "instantid_file": "ip-adapter.bin" }
  },
  "16": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "instantid/diffusion_pytorch_model.safetensors" }
  },
  "38": {
    "class_type": "InstantIDFaceAnalysis",
    "inputs": { "provider": "CUDA" }
  },
  "13": {
    "class_type": "LoadImage",
    "inputs": { "image": "reference.png" }
  },
  "39": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "score_9, score_8_up, source_anime, anime style, highly detailed",
      "clip": ["4", 1]
    }
  },
  "40": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "lowres, bad anatomy, bad hands, text, watermark, blurry, 3d, realistic, ugly, deformed face",
      "clip": ["4", 1]
    }
  },
  "60": {
    "class_type": "ApplyInstantID",
    "inputs": {
      "instantid": ["11", 0],
      "insightface": ["38", 0],
      "control_net": ["16", 0],
      "image": ["13", 0],
      "model": ["4", 0],
      "positive": ["39", 0],
      "negative": ["40", 0],
      "weight": 0.8,
      "start_at": 0,
      "end_at": 1
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 768, "height": 1024, "batch_size": 1 }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 30,
      "cfg": 4.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["60", 0],
      "positive": ["60", 1],
      "negative": ["60", 2],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "huobao/instantid", "images": ["8", 0] }
  }
}

{
  "_comment": "Kwai Kolors text2image via ComfyUI-KwaiKolorsWrapper (Chinese prompt native)",
  "1": {
    "class_type": "DownloadAndLoadKolorsModel",
    "inputs": {
      "model": "Kwai-Kolors/Kolors",
      "precision": "fp16"
    }
  },
  "2": {
    "class_type": "LoadChatGLM3",
    "inputs": {
      "chatglm3_checkpoint": "chatglm3-8bit.safetensors"
    }
  },
  "3": {
    "class_type": "KolorsTextEncode",
    "inputs": {
      "chatglm3_model": ["2", 0],
      "prompt": "高质量电影感动漫插画，大学宿舍清晨，青年男性程序员在窗前扶框揉眼，双层床、笔记本电脑、充电线，暖色晨光",
      "negative_prompt": "低质量，模糊，文字，水印，畸形",
      "num_images_per_prompt": 1
    }
  },
  "4": {
    "class_type": "KolorsSampler",
    "inputs": {
      "kolors_model": ["1", 0],
      "kolors_embeds": ["3", 0],
      "width": 1024,
      "height": 576,
      "seed": 42,
      "steps": 25,
      "cfg": 5,
      "scheduler": "EulerDiscreteScheduler"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "kolors_vae_fp16.safetensors"
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["4", 0],
      "vae": ["5", 0]
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "huobao/kolors",
      "images": ["6", 0]
    }
  }
}
